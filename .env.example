# Spag AI Studio - example settings.
# Copy this file to "apps/web/.env" and change values if needed. NEVER commit ".env".
# Every provider defaults to "mock" so the app runs locally for free.

# --- General ---
APP_URL=http://localhost:3000
APP_TIMEZONE=Africa/Lagos
APP_CURRENCY=NGN
# Long random string used to sign things. Change it in production.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database (docker compose provides this locally) ---
DATABASE_URL=postgresql://spagai:spagai@localhost:5432/spagai

# --- Email for login links (Mailpit from docker compose; inbox at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Spag AI Studio <no-reply@spagai.local>"
# smtp = send through SMTP above. console = print emails in the terminal (only allowed on localhost).
EMAIL_TRANSPORT=smtp
# Development only: after "Email me a sign-in link", show a button that opens the link directly.
# Never enable this on a live site (the app refuses to start in production with it on).
DEV_SHOW_LOGIN_LINK=true

# --- Providers (mock | openai_compatible | ...) ---
LLM_PROVIDER=mock
TTS_PROVIDER=mock
ASR_PROVIDER=mock
TELEPHONY_PROVIDER=mock
PAYMENTS_PROVIDER=mock

# Generic OpenAI-compatible endpoint (optional). Works with OpenAI, Groq, Together, or a local Ollama/vLLM server.
# To let the simulator use the real prompt: set LLM_PROVIDER=openai_compatible plus the base URL and model.
# Example base URL: https://api.openai.com/v1  (keep the key secret; never commit apps/web/.env)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
# Text-to-speech model, for TTS_PROVIDER=openai_compatible. Voices also need a providerVoiceId in packages/core/data/voices.json.
OPENAI_COMPATIBLE_TTS_MODEL=

# --- Payments (M5) ---
# mock = a pretend checkout page (no money moves). paystack = real payments.
# For Paystack: set the secret key from your Paystack dashboard, and set the webhook URL there to
# <APP_URL>/api/webhooks/paystack . The app refuses to start in production with PAYMENTS_PROVIDER=mock.
# (PAYMENTS_PROVIDER is set in the Providers section above.)
PAYSTACK_SECRET_KEY=

# --- Voice worker (M5) ---
# Shared secret between this app and services/voice-worker (32+ random characters, same value on both sides).
WORKER_SHARED_SECRET=

# Development only: make the Billing page wait this many milliseconds, to see the loading animation (0 = off).
DEV_BILLING_DELAY_MS=0
