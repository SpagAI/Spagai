// Spag AI Studio database schema.
// Money is stored as integer kobo. Times are stored in UTC and shown in Africa/Lagos.
// Never add columns for card numbers, PINs, one-time passwords or BVNs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id                String       @id @default(cuid())
  email             String       @unique
  name              String?
  /// Profile details (Account page).
  jobTitle          String       @default("")
  phone             String       @default("")
  /// Which emails this person wants, e.g. { "weeklySummary": true }.
  notificationPrefs Json         @default("{}")
  createdAt         DateTime     @default(now())
  lastLoginAt       DateTime?
  memberships       Membership[]
  sessions          Session[]
}

model Organisation {
  id                 String              @id @default(cuid())
  name               String
  timezone           String              @default("Africa/Lagos")
  currency           String              @default("NGN")
  /// Prepaid wallet balance in kobo. Changed only together with a WalletTransaction.
  balanceKobo        Int                 @default(0)
  /// Price per started minute of an answered call, in kobo (default ₦150).
  ratePerMinuteKobo  Int                 @default(15000)
  createdAt          DateTime            @default(now())
  memberships        Membership[]
  agents             Agent[]
  auditLogs          AuditLog[]
  leads              Lead[]
  doNotCall          DoNotCall[]
  campaigns          Campaign[]
  calls              Call[]
  walletTransactions WalletTransaction[]
  phoneNumbers       PhoneNumber[]
  sipTrunks          SipTrunk[]
  knowledgeItems     KnowledgeItem[]
  integrations       Integration[]
  apiKeys            ApiKey[]
  workspaceVoices    WorkspaceVoice[]
  tools              Tool[]
  providerUsage      ProviderUsage[]
  mcpServers         McpServer[]
  voiceUsage         VoiceUsage[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organisationId String
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@index([organisationId])
}

/// A signed-in browser. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id                   String   @id @default(cuid())
  tokenHash            String   @unique
  userId               String
  activeOrganisationId String?
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One-time email login link. Only the hash of the token is stored.
model LoginToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

enum AgentStatus {
  DRAFT
  READY
}

model Agent {
  id             String          @id @default(cuid())
  organisationId String
  name           String
  presetId       String?
  status         AgentStatus     @default(DRAFT)
  /// The full AgentConfig from @spagai/core (blocks, variables, tools, silence, voice...).
  config         Json
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  campaigns      Campaign[]
  calls          Call[]
  phoneNumbers   PhoneNumber[]
  knowledgeItems KnowledgeItem[]
  draft          AgentDraft?
  versions       AgentVersion[]

  @@index([organisationId])
}

/// Unsaved changes, kept automatically while someone edits an agent. Never used for calls:
/// only "Save" changes Agent.config. Separate table so autosaving does not touch Agent.updatedAt.
model AgentDraft {
  agentId   String   @id
  config    Json
  savedById String?
  updatedAt DateTime @updatedAt
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

/// Every saved version of an agent (newest kept: 50), so an earlier prompt can be restored.
model AgentVersion {
  id             String      @id @default(cuid())
  agentId        String
  organisationId String
  config         Json
  status         AgentStatus
  savedById      String?
  createdAt      DateTime    @default(now())
  agent          Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
}

/// Who did what. Extended for call compliance in M4.
model AuditLog {
  id             String       @id @default(cuid())
  organisationId String
  actorUserId    String?
  action         String
  targetType     String?
  targetId       String?
  details        Json?
  createdAt      DateTime     @default(now())
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, createdAt])
}

// ---------------------------------------------------------------------------
// M4: leads, do-not-call list, campaigns and calls
// ---------------------------------------------------------------------------

/// A person a business may call. Phone is E.164 (+234...). Never store BVN, card numbers, PINs or OTPs here.
model Lead {
  id             String         @id @default(cuid())
  organisationId String
  firstName      String
  lastName       String         @default("")
  title          String         @default("")
  /// "male", "female" or "" (unknown)
  gender         String         @default("")
  phone          String
  email          String         @default("")
  /// Where the lead came from (required before any call).
  source         String
  /// The business has a consent record for calling this person.
  consent        Boolean        @default(false)
  /// Where the person is (for the dashboard map). Optional.
  continent      String         @default("")
  country        String         @default("")
  countryCode    String         @default("")
  region         String         @default("")
  city           String         @default("")
  lat            Float?
  lng            Float?
  /// Extra imported columns, used as per-call variables.
  extra          Json           @default("{}")
  optedOut       Boolean        @default(false)
  optedOutAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  campaignLeads  CampaignLead[]
  calls          Call[]

  @@unique([organisationId, phone])
  @@index([organisationId, createdAt])
}

/// Numbers that must never be called by this organisation. Opt-outs are added automatically.
model DoNotCall {
  id             String       @id @default(cuid())
  organisationId String
  phone          String
  /// "opt_out" (the person asked on a call) or "manual" (added by a team member)
  reason         String
  note           String       @default("")
  createdAt      DateTime     @default(now())
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, phone])
}

enum CampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
}

model Campaign {
  id                String         @id @default(cuid())
  organisationId    String
  name              String
  agentId           String
  status            CampaignStatus @default(DRAFT)
  /// Calling window in Lagos time. Can only narrow 08:00-21:00.
  windowStart       String         @default("08:00")
  windowEnd         String         @default("21:00")
  /// Allowed weekdays, 0 = Sunday.
  days              Int[]          @default([1, 2, 3, 4, 5, 6])
  maxAttempts       Int            @default(3)
  retryAfterMinutes Int            @default(240)
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organisation      Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  agent             Agent          @relation(fields: [agentId], references: [id], onDelete: Restrict)
  leads             CampaignLead[]
  calls             Call[]

  @@index([organisationId, createdAt])
}

enum CampaignLeadStatus {
  PENDING
  DONE
  STOPPED
}

/// One lead inside one campaign, with its attempt history.
model CampaignLead {
  id            String             @id @default(cuid())
  campaignId    String
  leadId        String
  status        CampaignLeadStatus @default(PENDING)
  attempts      Int                @default(0)
  lastAttemptAt DateTime?
  /// Do not try again before this time (callbacks and retries).
  nextAttemptAt DateTime?
  outcome       String?
  campaign      Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead          Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@index([campaignId, status])
}

enum CallStatus {
  /// Stopped by the compliance gate before dialling.
  BLOCKED
  NO_ANSWER
  COMPLETED
  FAILED
}

/// Every call attempt, including blocked ones (the compliance audit trail).
model Call {
  id              String       @id @default(cuid())
  organisationId  String
  campaignId      String?
  leadId          String
  agentId         String?
  status          CallStatus
  /// Gate reasons when BLOCKED: [{ code, message, permanent }]
  blockReasons    Json?
  outcome         String?
  /// [{ role: "agent" | "caller", text }]
  transcript      Json?
  /// [{ tool, args }]
  toolCalls       Json?
  durationSeconds Int?
  /// What this call cost, in kobo (answered calls only).
  costKobo        Int?
  /// "mock" until real telephony is connected (M5).
  provider        String       @default("mock")
  /// The (possibly pretend) time the attempt was made, for mock runs.
  attemptedAt     DateTime
  createdAt       DateTime     @default(now())
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  campaign        Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  lead            Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent           Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([campaignId])
  @@index([leadId])
}

// ---------------------------------------------------------------------------
// M5: prepaid wallet in kobo
// ---------------------------------------------------------------------------

enum WalletTransactionType {
  TOPUP
  CALL_CHARGE
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

/// Every change to an organisation's balance. Amounts are signed kobo (top-ups positive, charges negative).
model WalletTransaction {
  id               String                  @id @default(cuid())
  organisationId   String
  type             WalletTransactionType
  status           WalletTransactionStatus @default(SUCCESS)
  amountKobo       Int
  /// Balance right after this transaction was applied (set when it succeeds).
  balanceAfterKobo Int?
  /// Unique payment or charge reference, so the same payment can never be credited twice.
  reference        String                  @unique
  /// "mock" or "paystack" for top-ups; "calls" for charges.
  provider         String
  callId           String?                 @unique
  description      String                  @default("")
  createdById      String?
  createdAt        DateTime                @default(now())
  completedAt      DateTime?
  organisation     Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, createdAt])
}

// ---------------------------------------------------------------------------
// M6: phone numbers, SIP trunks, knowledge bank, integrations, API keys
// (prototype: none of these talk to real providers yet)
// ---------------------------------------------------------------------------

enum PhoneNumberStatus {
  ACTIVE
  RELEASED
}

model PhoneNumber {
  id              String            @id @default(cuid())
  organisationId  String
  /// E.164, e.g. +2349012345678
  number          String
  countryCode     String
  country         String
  areaCode        String            @default("")
  /// "local", "mobile" or "toll_free"
  type            String            @default("local")
  /// "Spag AI" for bought numbers, or the SIP trunk name
  source          String            @default("Spag AI")
  /// The agent answers calls to this number.
  inboundEnabled  Boolean           @default(true)
  /// The agent calls people from this number.
  outboundEnabled Boolean           @default(true)
  monthlyCostKobo Int               @default(0)
  label           String            @default("")
  agentId         String?
  status          PhoneNumberStatus @default(ACTIVE)
  purchasedAt     DateTime          @default(now())
  releasedAt      DateTime?
  organisation    Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  agent           Agent?            @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([organisationId, status])
}

model SipTrunk {
  id             String       @id @default(cuid())
  organisationId String
  name           String
  /// africas_talking, twilio, vonage, telnyx, plivo or other
  provider       String       @default("other")
  /// "both", "inbound" or "outbound"
  direction      String       @default("both")
  host           String
  port           Int          @default(5060)
  /// "udp", "tcp" or "tls"
  transport      String       @default("udp")
  username       String       @default("")
  hasPassword    Boolean      @default(false)
  /// The SIP password, encrypted ("" when none).
  passwordEncrypted String    @default("")
  /// "credentials" (username and password) or "ip" (the provider trusts our addresses)
  authMode       String       @default("credentials")
  /// "saved" (no phone system connected yet), "connected" or "error"
  status         String       @default("saved")
  createdAt      DateTime     @default(now())
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

enum KnowledgeKind {
  FILE
  WEBSITE
  TEXT
}

enum KnowledgeStatus {
  PROCESSING
  READY
  FAILED
}

/// A file or scraped website linked to an agent. Prototype: only details are stored, not the content.
model KnowledgeItem {
  id             String          @id @default(cuid())
  organisationId String
  agentId        String
  kind           KnowledgeKind
  name           String
  url            String          @default("")
  sizeBytes      Int             @default(0)
  mimeType       String          @default("")
  /// Pages read from a website
  pages          Int             @default(0)
  /// Searchable pieces the content was split into
  chunks         Int             @default(0)
  status         KnowledgeStatus @default(READY)
  /// Characters of text actually stored (0 for items added before the knowledge base read content).
  contentChars   Int             @default(0)
  /// Why reading failed, in plain words.
  error          String?
  createdById    String?
  createdAt      DateTime        @default(now())
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  agent          Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  pieces         KnowledgeChunk[]

  @@index([organisationId, createdAt])
}

/// A searchable piece of a knowledge item (about a paragraph), found by full-text search during calls.
model KnowledgeChunk {
  id             String        @id @default(cuid())
  itemId         String
  organisationId String
  agentId        String
  position       Int
  text           String
  item           KnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([itemId, position])
}

model Integration {
  id             String       @id @default(cuid())
  organisationId String
  /// "make", "zapier", "n8n", "google_calendar", "cal_com", "hubspot", "slack", "webhook"
  provider       String
  /// Display detail, e.g. the connected account or webhook URL
  detail         String       @default("")
  connectedAt    DateTime     @default(now())
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, provider])
}

/// API keys. The key is stored encrypted (so it can be revealed) and hashed (to check requests).
model ApiKey {
  id             String       @id @default(cuid())
  organisationId String
  name           String
  /// First characters shown in lists, e.g. "spag_live_3f9a"
  prefix         String
  keyHash        String       @unique
  keyEncrypted   String
  createdById    String?
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

/// A voice from an outside voice bank (e.g. Fish Audio) that this workspace added to its own list.
/// Agents refer to it as "<provider>:<providerVoiceId>". Details are copied from the provider when added.
model WorkspaceVoice {
  id              String       @id @default(cuid())
  organisationId  String
  provider        String       // "fish_audio"
  providerVoiceId String
  name            String
  gender          String       // "female" | "male"
  language        String       // en-NG, pcm, yo, ha, ig
  accent          String
  description     String
  age             String       // young | middle | mature
  sampleUrl       String?
  addedById       String?
  createdAt       DateTime     @default(now())
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, provider, providerVoiceId])
}

/// Characters of real speech generated per workspace per day (Lagos date), for the daily cost guard.
model VoiceUsage {
  organisationId String
  day            String       // YYYY-MM-DD in Africa/Lagos
  characters     Int          @default(0)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@id([organisationId, day])
}

/// A connected MCP server (e.g. Make.com): its tools can be switched on for agents.
model McpServer {
  id             String       @id @default(cuid())
  organisationId String
  /// Short name used in tool names the AI sees ("make" -> make__book_appointment), unique in the workspace.
  name           String
  label          String
  /// The full address, encrypted (Make puts the access token inside it).
  urlEncrypted   String
  /// Shown instead of the address, e.g. "eu2.make.com".
  urlHost        String
  /// Optional Authorization header value, encrypted ("" when none).
  authEncrypted  String       @default("")
  /// Tools the server offers: [{ name, description, inputSchema, allowed }]
  tools          Json         @default("[]")
  lastSyncedAt   DateTime?
  lastError      String?
  timeoutMs      Int          @default(15000)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  runs           McpRun[]

  @@unique([organisationId, name])
}

/// Each time an MCP tool ran (newest 50 kept per server).
model McpRun {
  id             String    @id @default(cuid())
  serverId       String
  organisationId String
  toolName       String
  /// "test", "talk" or "call"
  source         String
  request        Json
  ok             Boolean
  response       String
  durationMs     Int
  error          String?
  createdAt      DateTime  @default(now())
  server         McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt])
}

/// How much of each paid outside service a workspace used per Lagos day (for the Usage page; nothing is charged).
model ProviderUsage {
  organisationId String
  day            String       // YYYY-MM-DD in Africa/Lagos
  /// ai_input_tokens, ai_output_tokens, ai_replies, voice_characters, listening_seconds
  kind           String
  /// groq, fish_audio, ...
  provider       String
  quantity       Int          @default(0)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@id([organisationId, day, kind, provider])
}

/// A workspace's own tool: an action an agent can take during a call by calling a webhook.
model Tool {
  id             String       @id @default(cuid())
  organisationId String
  /// The name the AI uses (lowercase, underscores), unique in the workspace.
  name           String
  label          String
  /// When the agent should use it, in plain words (the AI reads this).
  description    String
  /// Details the AI collects: [{ name, type, required, description, options? }]
  parameters     Json
  url            String
  method         String       @default("POST")
  /// [{ name, value, secret }]; secret values are encrypted.
  headers        Json
  /// Extra facts sent with every call: { agent, call, caller, lead, time }
  sendContext    Json
  timeoutMs      Int          @default(10000)
  waitMessage    String       @default("")
  /// Encrypted secret for the X-Spag-Signature header.
  signingSecret  String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  runs           ToolRun[]

  @@unique([organisationId, name])
}

/// Each time a tool ran (newest 50 kept per tool), to see what was sent and what came back.
model ToolRun {
  id             String   @id @default(cuid())
  toolId         String
  organisationId String
  agentId        String?
  /// "test" (Send a test), "talk" (Test your agent) or "call" (a real call)
  source         String
  request        Json
  status         Int?
  ok             Boolean
  response       String
  durationMs     Int
  error          String?
  createdAt      DateTime @default(now())
  tool           Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([toolId, createdAt])
}
